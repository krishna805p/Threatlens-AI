# ==============================================================================
# ThreatLens AI — Local & Production Environment Configuration Template
# Copy this file to '.env' and populate with your local configuration.
# NEVER commit the active '.env' file or secret credentials to version control.
# ==============================================================================

# Server & Networking
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Gmail OAuth 2.0 (Google Cloud Web Application Client)
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/auth/callback
GMAIL_TOKEN_PATH=.secrets/gmail_token.json
GMAIL_PROFILE_PATH=.secrets/gmail_profile.json
GMAIL_CREDENTIALS_PATH=.secrets/credentials.json
GMAIL_SCAN_LIMIT=20

# External Intelligence APIs (Optional — leave blank to operate without them)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Worker Python Interpreter (Optional — defaults to sys.executable in Docker)
DISTILBERT_PYTHON_BIN=
