# Optional URL-reputation API credentials. Leave blank to run without them.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Gmail Security integration (local OAuth only; never commit these files).
GMAIL_CREDENTIALS_PATH=.secrets/credentials.json
GMAIL_TOKEN_PATH=.secrets/gmail_token.json
GMAIL_SCAN_LIMIT=20
